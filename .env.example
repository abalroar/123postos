# Telegram Bot (obrigatório — crie via @BotFather)
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# IDs autorizados a controlar o bot (vírgula para múltiplos)
# Se vazio, usa TELEGRAM_CHAT_ID como fallback
ALLOWED_CHAT_IDS=seu_chat_id_aqui

# Amadeus API (opcional — deixe em branco)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
