# Telegram Bot (required — create via @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Amadeus API (optional — fallback only, free tier at developers.amadeus.com)
# Not needed if using scraper as primary data source.
# Self-service portal shuts down July 17, 2026.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
